                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock  FontSize="17" FontWeight="Bold" Foreground="#06B6D4"><TextBlock.Text><MultiBinding Converter="{StaticResource LocFmt}"><Binding Path="[fmt_configuring]" Source="{x:Static svc:L10n.I}"/><Binding Path="MButtonName"/></MultiBinding></TextBlock.Text></TextBlock>
                                                <Border Background="#1E293B" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TriggerDisplayName}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                                                </Border>
                                            </StackPanel>

