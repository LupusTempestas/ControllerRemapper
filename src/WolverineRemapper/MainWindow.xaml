                                            <Button Grid.Column="1" Content="{Binding [rebind_key], Source={x:Static svc:L10n.I}}"
                                                    Visibility="{Binding IsKeyboardTrigger, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.RebindCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource GhostButtonStyle}"/>

