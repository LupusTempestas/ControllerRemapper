                                            <RadioButton Content="{Binding [multiple_times], Source={x:Static svc:L10n.I}}" IsChecked="{Binding IsRepeatCount}" Style="{StaticResource PillToggleStyle}"
                                                         ToolTip="{Binding [fire_the_action_a_set], Source={x:Static svc:L10n.I}}"/>
                                            <RadioButton Content="{Binding [while_held], Source={x:Static svc:L10n.I}}" IsChecked="{Binding IsRepeatWhileHeld}" Style="{StaticResource PillToggleStyle}"
                                                         ToolTip="{Binding [repeat_continuously_until_you_release], Source={x:Static svc:L10n.I}}"/>
                                        </WrapPanel>
                                        <StackPanel Visibility="{Binding IsRepeatCount, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                            <TextBlock  Style="{StaticResource SectionLabel}"><TextBlock.Text><MultiBinding Converter="{StaticResource LocFmt}"><Binding Path="[fmt_how_many_times]" Source="{x:Static svc:L10n.I}"/><Binding Path="RepeatCount"/></MultiBinding></TextBlock.Text></TextBlock>
                                            <Slider Minimum="2" Maximum="20" Value="{Binding RepeatCount}" Foreground="#06B6D4" TickFrequency="1" IsSnapToTickEnabled="True"
                                                    IsEnabled="{Binding RepeatLimitApplies}"/>
                                            <CheckBox Content="{Binding [ignore_limit], Source={x:Static svc:L10n.I}}"
                                                      IsChecked="{Binding IgnoreRepeatLimit}" FontSize="12" Margin="0,6,0,0"
                                                      ToolTip="{Binding [ignore_limit_tip], Source={x:Static svc:L10n.I}}"/>
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding IsRepeatOnce, Converter={StaticResource InvBoolToVis}}" Margin="0,0,0,4">
                                            <TextBlock  Style="{StaticResource SectionLabel}"><TextBlock.Text><MultiBinding Converter="{StaticResource LocFmt}"><Binding Path="[fmt_speed_ms_between_repeats]" Source="{x:Static svc:L10n.I}"/><Binding Path="RepeatGapMs"/></MultiBinding></TextBlock.Text></TextBlock>
                                            <Slider Minimum="20" Maximum="300" Value="{Binding RepeatGapMs}" Foreground="#06B6D4" TickFrequency="5" IsSnapToTickEnabled="True"/>
                                        </StackPanel>
                                        <Border Height="1" Background="#334155" Margin="0,8,0,12"/>

                                        <!-- Action mode selector -->
                                        <TextBlock Text="{Binding [action_type_what_it_sends], Source={x:Static svc:L10n.I}}" Style="{StaticResource SectionLabel}"/>
                                        <WrapPanel Margin="0,0,0,12">
                                            <RadioButton Content="{Binding [chord_all_at_once], Source={x:Static svc:L10n.I}}" IsChecked="{Binding IsChordMode}" Style="{StaticResource PillToggleStyle}"
                                                         ToolTip="{Binding [all_selected_buttons_press_together], Source={x:Static svc:L10n.I}}"/>
                                            <RadioButton Content="{Binding [hold_press], Source={x:Static svc:L10n.I}}" IsChecked="{Binding IsHoldTapMode}" Style="{StaticResource PillToggleStyle}"
                                                         ToolTip="{Binding [hold_the_first_set_wait], Source={x:Static svc:L10n.I}}"/>
                                            <RadioButton Content="{Binding [macro_sequence], Source={x:Static svc:L10n.I}}" IsChecked="{Binding IsSequenceMode}" Style="{StaticResource PillToggleStyle}"
                                                         ToolTip="{Binding [build_your_own_ordered_sequence], Source={x:Static svc:L10n.I}}"/>
                                        </WrapPanel>

                                        <!-- ══ CHORD MODE ══ -->
                                        <StackPanel Visibility="{Binding IsChordMode, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding [face_buttons], Source={x:Static svc:L10n.I}}" Style="{StaticResource SectionLabel}"/>
                                            <WrapPanel Margin="0,0,0,10">
                                                <ToggleButton Content="A" IsChecked="{Binding A}" Style="{StaticResource PillToggleStyle}" Width="68"/>
                                                <ToggleButton Content="B" IsChecked="{Binding B}" Style="{StaticResource PillToggleStyle}" Width="68"/>
                                                <ToggleButton Content="X" IsChecked="{Binding X}" Style="{StaticResource PillToggleStyle}" Width="68"/>
                                                <ToggleButton Content="Y" IsChecked="{Binding Y}" Style="{StaticResource PillToggleStyle}" Width="68"/>
                                            </WrapPanel>

                                            <TextBlock Text="{Binding [shoulders_triggers], Source={x:Static svc:L10n.I}}" Style="{StaticResource SectionLabel}"/>
                                            <WrapPanel Margin="0,0,0,10">
                                                <ToggleButton Content="LB" IsChecked="{Binding LB}" Style="{StaticResource PillToggleStyle}" Width="68"/>
                                                <ToggleButton Content="RB" IsChecked="{Binding RB}" Style="{StaticResource PillToggleStyle}" Width="68"/>
                                                <ToggleButton Content="LT" IsChecked="{Binding LT}" Style="{StaticResource PillToggleStyle}" Width="68"/>
                                                <ToggleButton Content="RT" IsChecked="{Binding RT}" Style="{StaticResource PillToggleStyle}" Width="68"/>
                                            </WrapPanel>

                                            <TextBlock Text="{Binding [d_pad], Source={x:Static svc:L10n.I}}" Style="{StaticResource SectionLabel}"/>
                                            <WrapPanel Margin="0,0,0,10">
                                                <ToggleButton Content="{Binding [up], Source={x:Static svc:L10n.I}}" IsChecked="{Binding DPadUp}" Style="{StaticResource PillToggleStyle}" Width="86"/>
                                                <ToggleButton Content="{Binding [down], Source={x:Static svc:L10n.I}}" IsChecked="{Binding DPadDown}" Style="{StaticResource PillToggleStyle}" Width="86"/>
                                                <ToggleButton Content="{Binding [left], Source={x:Static svc:L10n.I}}" IsChecked="{Binding DPadLeft}" Style="{StaticResource PillToggleStyle}" Width="86"/>
                                                <ToggleButton Content="{Binding [right], Source={x:Static svc:L10n.I}}" IsChecked="{Binding DPadRight}" Style="{StaticResource PillToggleStyle}" Width="86"/>
                                            </WrapPanel>

                                            <TextBlock Text="{Binding [sticks_system], Source={x:Static svc:L10n.I}}" Style="{StaticResource SectionLabel}"/>
                                            <WrapPanel Margin="0,0,0,10">
                                                <ToggleButton Content="{Binding [ls_click], Source={x:Static svc:L10n.I}}" IsChecked="{Binding LSClick}" Style="{StaticResource PillToggleStyle}" Width="86"/>
                                                <ToggleButton Content="{Binding [rs_click], Source={x:Static svc:L10n.I}}" IsChecked="{Binding RSClick}" Style="{StaticResource PillToggleStyle}" Width="86"/>
                                                <ToggleButton Content="{Binding [view], Source={x:Static svc:L10n.I}}" IsChecked="{Binding View}" Style="{StaticResource PillToggleStyle}" Width="86"/>
                                                <ToggleButton Content="{Binding [menu], Source={x:Static svc:L10n.I}}" IsChecked="{Binding Menu}" Style="{StaticResource PillToggleStyle}" Width="86"/>
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- ══ HOLD + PRESS MODE ══ -->
                                        <StackPanel Visibility="{Binding IsHoldTapMode, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding [step_1_hold_these_first], Source={x:Static svc:L10n.I}}" Style="{StaticResource SectionLabel}"/>
                                            <ItemsControl ItemsSource="{Binding HoldPicks}" Margin="0,0,0,10">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ToggleButton Content="{Binding Id, Converter={StaticResource ButtonName}}" IsChecked="{Binding IsSelected}" Style="{StaticResource PillToggleStyle}" MinWidth="64"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="{Binding [step_2_then_press_while], Source={x:Static svc:L10n.I}}" Style="{StaticResource SectionLabel}"/>
                                            <ItemsControl ItemsSource="{Binding TapPicks}" Margin="0,0,0,10">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ToggleButton Content="{Binding Id, Converter={StaticResource ButtonName}}" IsChecked="{Binding IsSelected}" Style="{StaticResource PillToggleStyle}" MinWidth="64"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock  Style="{StaticResource SectionLabel}"><TextBlock.Text><MultiBinding Converter="{StaticResource LocFmt}"><Binding Path="[fmt_delay_between_steps_ms]" Source="{x:Static svc:L10n.I}"/><Binding Path="HoldTapDelayMs"/></MultiBinding></TextBlock.Text></TextBlock>
                                            <Slider Minimum="20" Maximum="500" Value="{Binding HoldTapDelayMs}" Foreground="#06B6D4"
                                                    TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,0,0,8"/>
                                            <TextBlock Text="{Binding [everything_releases_when_you_let], Source={x:Static svc:L10n.I}}" FontSize="11" Foreground="#94A3B8"/>
                                        </StackPanel>

                                        <!-- ══ MACRO MODE ══ -->
                                        <StackPanel Visibility="{Binding IsSequenceMode, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding [add_a_step], Source={x:Static svc:L10n.I}}" Style="{StaticResource SectionLabel}"/>
                                            <WrapPanel Margin="0,0,0,10">
                                                <Button Content="{Binding [press], Source={x:Static svc:L10n.I}}" Style="{StaticResource GhostButtonStyle}" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.AddStepCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Press"
                                                        ToolTip="{Binding [press_a_button_and_keep], Source={x:Static svc:L10n.I}}"/>
                                                <Button Content="{Binding [release], Source={x:Static svc:L10n.I}}" Style="{StaticResource GhostButtonStyle}" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.AddStepCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Release"
                                                        ToolTip="{Binding [release_a_button_pressed_earlier], Source={x:Static svc:L10n.I}}"/>
                                                <Button Content="{Binding [tap], Source={x:Static svc:L10n.I}}" Style="{StaticResource GhostButtonStyle}" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.AddStepCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Tap"
                                                        ToolTip="{Binding [press_hold_briefly_release_one], Source={x:Static svc:L10n.I}}"/>
                                                <Button Content="{Binding [wait], Source={x:Static svc:L10n.I}}" Style="{StaticResource GhostButtonStyle}" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.AddStepCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Wait"
                                                        ToolTip="{Binding [pause_between_steps], Source={x:Static svc:L10n.I}}"/>
                                                <Button Content="{Binding [push_stick], Source={x:Static svc:L10n.I}}" Style="{StaticResource GhostButtonStyle}" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.AddStepCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="PushStick"
                                                        ToolTip="{Binding [hold_a_thumbstick_at_a], Source={x:Static svc:L10n.I}}"/>
                                                <Button Content="{Binding [center_stick], Source={x:Static svc:L10n.I}}" Style="{StaticResource GhostButtonStyle}"
                                                        Command="{Binding DataContext.AddStepCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="CenterStick"
                                                        ToolTip="{Binding [recenter_a_thumbstick_pushed_earlier], Source={x:Static svc:L10n.I}}"/>
                                            </WrapPanel>

                                            <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepEditorTemplate}"/>

                                            <TextBlock Text="{Binding [a_started_macro_always_runs], Source={x:Static svc:L10n.I}}"
                                                       FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                                </TabItem>

                                <!-- ══ RECORDER TAB ══ -->
                                <TabItem Header="{Binding [tab_recorder], Source={x:Static svc:L10n.I}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [record_intro], Source={x:Static svc:L10n.I}}" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                        <Button Content="{Binding [record_from_pad], Source={x:Static svc:L10n.I}}"
                                                Command="{Binding DataContext.RecordMacroCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Style="{StaticResource ActionButtonStyle}" Height="40" MinWidth="260" HorizontalAlignment="Left"
                                                ToolTip="{Binding [record_tip], Source={x:Static svc:L10n.I}}"/>
                                        <Border Height="1" Background="#334155" Margin="0,14,0,12"/>

                                        <!-- Detection parameters (app-wide, saved in settings) -->
                                        <TextBlock Text="{Binding [record_detection], Source={x:Static svc:L10n.I}}" Style="{StaticResource SectionLabel}"/>
                                        <TextBlock Style="{StaticResource SectionLabel}" Margin="0,4,0,0"><TextBlock.Text><MultiBinding Converter="{StaticResource LocFmt}"><Binding Path="[fmt_tap_threshold]" Source="{x:Static svc:L10n.I}"/><Binding Path="DataContext.RecordTapThresholdMs" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.Text></TextBlock>
                                        <Slider Minimum="50" Maximum="400" Value="{Binding DataContext.RecordTapThresholdMs, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#06B6D4" TickFrequency="10" IsSnapToTickEnabled="True"
                                                ToolTip="{Binding [record_tap_threshold_tip], Source={x:Static svc:L10n.I}}"/>
                                        <TextBlock Style="{StaticResource SectionLabel}" Margin="0,8,0,0"><TextBlock.Text><MultiBinding Converter="{StaticResource LocFmt}"><Binding Path="[fmt_stick_threshold]" Source="{x:Static svc:L10n.I}"/><Binding Path="DataContext.RecordStickThresholdPercent" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.Text></TextBlock>
                                        <Slider Minimum="20" Maximum="80" Value="{Binding DataContext.RecordStickThresholdPercent, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#06B6D4" TickFrequency="5" IsSnapToTickEnabled="True"/>
                                        <CheckBox Content="{Binding [record_keep_waits], Source={x:Static svc:L10n.I}}" IsChecked="{Binding DataContext.RecordKeepWaits, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" Margin="0,10,0,0"
                                                  ToolTip="{Binding [record_keep_waits_tip], Source={x:Static svc:L10n.I}}"/>
                                        <CheckBox Content="{Binding [record_hold_at_end], Source={x:Static svc:L10n.I}}" IsChecked="{Binding DataContext.RecordHoldAtEnd, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" Margin="0,6,0,0"
                                                  ToolTip="{Binding [record_hold_at_end_tip], Source={x:Static svc:L10n.I}}"/>
                                        <Border Height="1" Background="#334155" Margin="0,12,0,12"/>

                                        <!-- Repeat (same settings as the MANUAL tab — one M-button, one repeat mode) -->
                                        <TextBlock Text="{Binding [repeat_how_many_times], Source={x:Static svc:L10n.I}}" Style="{StaticResource SectionLabel}"/>
                                        <WrapPanel Margin="0,0,0,4">
                                            <RadioButton Content="{Binding [once], Source={x:Static svc:L10n.I}}" IsChecked="{Binding IsRepeatOnce}" Style="{StaticResource PillToggleStyle}"
                                                         ToolTip="{Binding [run_the_action_a_single], Source={x:Static svc:L10n.I}}"/>
                                            <RadioButton Content="{Binding [multiple_times], Source={x:Static svc:L10n.I}}" IsChecked="{Binding IsRepeatCount}" Style="{StaticResource PillToggleStyle}"
                                                         ToolTip="{Binding [fire_the_action_a_set], Source={x:Static svc:L10n.I}}"/>
                                            <RadioButton Content="{Binding [while_held], Source={x:Static svc:L10n.I}}" IsChecked="{Binding IsRepeatWhileHeld}" Style="{StaticResource PillToggleStyle}"
                                                         ToolTip="{Binding [repeat_continuously_until_you_release], Source={x:Static svc:L10n.I}}"/>
                                        </WrapPanel>
                                        <StackPanel Visibility="{Binding IsRepeatCount, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                            <TextBlock  Style="{StaticResource SectionLabel}"><TextBlock.Text><MultiBinding Converter="{StaticResource LocFmt}"><Binding Path="[fmt_how_many_times]" Source="{x:Static svc:L10n.I}"/><Binding Path="RepeatCount"/></MultiBinding></TextBlock.Text></TextBlock>
                                            <Slider Minimum="2" Maximum="20" Value="{Binding RepeatCount}" Foreground="#06B6D4" TickFrequency="1" IsSnapToTickEnabled="True"
                                                    IsEnabled="{Binding RepeatLimitApplies}"/>
                                            <CheckBox Content="{Binding [ignore_limit], Source={x:Static svc:L10n.I}}"
                                                      IsChecked="{Binding IgnoreRepeatLimit}" FontSize="12" Margin="0,6,0,0"
                                                      ToolTip="{Binding [ignore_limit_tip], Source={x:Static svc:L10n.I}}"/>
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding IsRepeatOnce, Converter={StaticResource InvBoolToVis}}" Margin="0,0,0,4">
                                            <TextBlock  Style="{StaticResource SectionLabel}"><TextBlock.Text><MultiBinding Converter="{StaticResource LocFmt}"><Binding Path="[fmt_speed_ms_between_repeats]" Source="{x:Static svc:L10n.I}"/><Binding Path="RepeatGapMs"/></MultiBinding></TextBlock.Text></TextBlock>
                                            <Slider Minimum="20" Maximum="300" Value="{Binding RepeatGapMs}" Foreground="#06B6D4" TickFrequency="5" IsSnapToTickEnabled="True"/>
                                        </StackPanel>
                                        <Border Height="1" Background="#334155" Margin="0,8,0,12"/>

                                        <!-- What was recorded: same editable rows as the macro editor -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding [record_steps_title], Source={x:Static svc:L10n.I}}" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding HasSteps, Converter={StaticResource BoolToVis}}">
                                                <Button Content="{Binding [record_again], Source={x:Static svc:L10n.I}}" Style="{StaticResource GhostButtonStyle}" Foreground="#F43F5E" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.RecordMacroCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                <Button Content="{Binding [record_clear], Source={x:Static svc:L10n.I}}" Style="{StaticResource GhostButtonStyle}"
                                                        Command="{Binding DataContext.ClearStepsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding [record_no_steps], Source={x:Static svc:L10n.I}}" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"
                                                   Visibility="{Binding HasSteps, Converter={StaticResource InvBoolToVis}}"/>
                                        <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepEditorTemplate}"
                                                      Visibility="{Binding HasSteps, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding [record_edit_hint], Source={x:Static svc:L10n.I}}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </ScrollViewer>
                                </TabItem>
                                </TabControl>

                                <Border Grid.Row="2" Background="#0F172A" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding [output], Source={x:Static svc:L10n.I}}" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ChordSummary}" FontSize="14" FontWeight="Bold" Foreground="#10B981" Margin="8,0,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ── TAB 3: STICK ANALYZER ── -->
                <TabItem Header="{Binding [stick_deadzone_analyzer], Source={x:Static svc:L10n.I}}">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left stick radar -->
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,8,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding [left_thumbstick], Source={x:Static svc:L10n.I}}" FontSize="13" FontWeight="Bold" Foreground="#06B6D4" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0" Width="280" HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding LeftStickXNorm, StringFormat='X  {0:F3}'}" FontSize="12" Foreground="#F8FAFC" FontFamily="Consolas"/>
                                        <TextBlock Text="{Binding LeftStickYNorm, StringFormat='Y  {0:F3}'}" FontSize="12" Foreground="#F8FAFC" FontFamily="Consolas"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock  FontSize="12" FontWeight="Bold" Foreground="#10B981"><TextBlock.Text><MultiBinding Converter="{StaticResource LocFmt}"><Binding Path="[fmt_deflection]" Source="{x:Static svc:L10n.I}"/><Binding Path="LeftStickMagnitude"/></MultiBinding></TextBlock.Text></TextBlock>
                                        <TextBlock  FontSize="12" FontWeight="Bold" Foreground="#F43F5E"><TextBlock.Text><MultiBinding Converter="{StaticResource LocFmt}"><Binding Path="[fmt_drift_at_rest]" Source="{x:Static svc:L10n.I}"/><Binding Path="LeftStickDriftPercent"/></MultiBinding></TextBlock.Text></TextBlock>
                                    </StackPanel>
                                </Grid>
                                <Viewbox Stretch="Uniform">
                                <Canvas Width="200" Height="200" Background="#0F172A">
                                    <Ellipse Canvas.Left="7" Canvas.Top="7" Width="186" Height="186" Stroke="#334155" StrokeThickness="2"/>
                                    <Line X1="100" Y1="0" X2="100" Y2="200" Stroke="#1E293B" StrokeThickness="1"/>
                                    <Line X1="0" Y1="100" X2="200" Y2="100" Stroke="#1E293B" StrokeThickness="1"/>
                                    <!-- Outer saturation ring -->
                                    <Ellipse Stroke="#06B6D4" StrokeThickness="1" StrokeDashArray="4 3"
                                             Width="{Binding OuterDeadzone, Converter={StaticResource Scale}, ConverterParameter='1.86'}"
                                             Height="{Binding OuterDeadzone, Converter={StaticResource Scale}, ConverterParameter='1.86'}"
                                             Canvas.Left="{Binding OuterDeadzone, Converter={StaticResource Scale}, ConverterParameter='-0.93,100'}"
                                             Canvas.Top="{Binding OuterDeadzone, Converter={StaticResource Scale}, ConverterParameter='-0.93,100'}"/>
                                    <!-- Inner deadzone ring -->
                                    <Ellipse Stroke="#F43F5E" StrokeThickness="1" StrokeDashArray="3 2" Fill="#14F43F5E"
                                             Width="{Binding InnerDeadzone, Converter={StaticResource Scale}, ConverterParameter='1.86'}"
                                             Height="{Binding InnerDeadzone, Converter={StaticResource Scale}, ConverterParameter='1.86'}"
                                             Canvas.Left="{Binding InnerDeadzone, Converter={StaticResource Scale}, ConverterParameter='-0.93,100'}"
                                             Canvas.Top="{Binding InnerDeadzone, Converter={StaticResource Scale}, ConverterParameter='-0.93,100'}"/>
                                    <Ellipse Width="14" Height="14" Fill="#10B981" Stroke="#34D399" StrokeThickness="2"
                                             Canvas.Left="{Binding LeftStickCanvasX}" Canvas.Top="{Binding LeftStickCanvasY}"/>
                                </Canvas>
                                </Viewbox>
                            </DockPanel>
                        </Border>

                        <!-- Right stick radar -->
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Padding="16" Margin="8,0,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding [right_thumbstick], Source={x:Static svc:L10n.I}}" FontSize="13" FontWeight="Bold" Foreground="#06B6D4" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0" Width="280" HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding RightStickXNorm, StringFormat='X  {0:F3}'}" FontSize="12" Foreground="#F8FAFC" FontFamily="Consolas"/>
                                        <TextBlock Text="{Binding RightStickYNorm, StringFormat='Y  {0:F3}'}" FontSize="12" Foreground="#F8FAFC" FontFamily="Consolas"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock  FontSize="12" FontWeight="Bold" Foreground="#10B981"><TextBlock.Text><MultiBinding Converter="{StaticResource LocFmt}"><Binding Path="[fmt_deflection_2]" Source="{x:Static svc:L10n.I}"/><Binding Path="RightStickMagnitude"/></MultiBinding></TextBlock.Text></TextBlock>
                                        <TextBlock  FontSize="12" FontWeight="Bold" Foreground="#F43F5E"><TextBlock.Text><MultiBinding Converter="{StaticResource LocFmt}"><Binding Path="[fmt_drift_at_rest_2]" Source="{x:Static svc:L10n.I}"/><Binding Path="RightStickDriftPercent"/></MultiBinding></TextBlock.Text></TextBlock>
                                    </StackPanel>
                                </Grid>
                                <Viewbox Stretch="Uniform">
                                <Canvas Width="200" Height="200" Background="#0F172A">
                                    <Ellipse Canvas.Left="7" Canvas.Top="7" Width="186" Height="186" Stroke="#334155" StrokeThickness="2"/>
                                    <Line X1="100" Y1="0" X2="100" Y2="200" Stroke="#1E293B" StrokeThickness="1"/>
                                    <Line X1="0" Y1="100" X2="200" Y2="100" Stroke="#1E293B" StrokeThickness="1"/>
                                    <Ellipse Stroke="#06B6D4" StrokeThickness="1" StrokeDashArray="4 3"
                                             Width="{Binding OuterDeadzone, Converter={StaticResource Scale}, ConverterParameter='1.86'}"
                                             Height="{Binding OuterDeadzone, Converter={StaticResource Scale}, ConverterParameter='1.86'}"
                                             Canvas.Left="{Binding OuterDeadzone, Converter={StaticResource Scale}, ConverterParameter='-0.93,100'}"
                                             Canvas.Top="{Binding OuterDeadzone, Converter={StaticResource Scale}, ConverterParameter='-0.93,100'}"/>
                                    <Ellipse Stroke="#F43F5E" StrokeThickness="1" StrokeDashArray="3 2" Fill="#14F43F5E"
                                             Width="{Binding InnerDeadzone, Converter={StaticResource Scale}, ConverterParameter='1.86'}"
                                             Height="{Binding InnerDeadzone, Converter={StaticResource Scale}, ConverterParameter='1.86'}"
                                             Canvas.Left="{Binding InnerDeadzone, Converter={StaticResource Scale}, ConverterParameter='-0.93,100'}"
                                             Canvas.Top="{Binding InnerDeadzone, Converter={StaticResource Scale}, ConverterParameter='-0.93,100'}"/>
                                    <Ellipse Width="14" Height="14" Fill="#10B981" Stroke="#34D399" StrokeThickness="2"
                                             Canvas.Left="{Binding RightStickCanvasX}" Canvas.Top="{Binding RightStickCanvasY}"/>
                                </Canvas>
                                </Viewbox>
                            </DockPanel>
                        </Border>

                        <!-- Deadzone controls -->
                        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <TextBlock  Style="{StaticResource SectionLabel}"><TextBlock.Text><MultiBinding Converter="{StaticResource LocFmt}"><Binding Path="[fmt_inner_deadzone_red_ring_input]" Source="{x:Static svc:L10n.I}"/><Binding Path="InnerDeadzone"/></MultiBinding></TextBlock.Text></TextBlock>
                                    <Slider Minimum="0" Maximum="40" Value="{Binding InnerDeadzone}" Foreground="#F43F5E" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                    <TextBlock  Style="{StaticResource SectionLabel}"><TextBlock.Text><MultiBinding Converter="{StaticResource LocFmt}"><Binding Path="[fmt_outer_saturation_cyan_ring_input]" Source="{x:Static svc:L10n.I}"/><Binding Path="OuterDeadzone"/></MultiBinding></TextBlock.Text></TextBlock>
                                    <Slider Minimum="60" Maximum="100" Value="{Binding OuterDeadzone}" Foreground="#06B6D4" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ══ Settings tab ══ -->
                <TabItem Header="{Binding [settings_tab], Source={x:Static svc:L10n.I}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                        <StackPanel MaxWidth="980" HorizontalAlignment="Left">

                            <!-- General -->
                            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding [settings_general], Source={x:Static svc:L10n.I}}" Style="{StaticResource SectionLabel}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                                        <TextBlock Text="🌐" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding [settings_language], Source={x:Static svc:L10n.I}}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox Style="{StaticResource DarkCombo}" Width="160"
                                                  ItemsSource="{Binding Languages}" SelectedItem="{Binding CurrentLanguage, Mode=TwoWay}"
                                                  ToolTip="{Binding [ui_language_tip], Source={x:Static svc:L10n.I}}"/>
                                    </StackPanel>
                                    <CheckBox Content="{Binding [settings_start_with_windows], Source={x:Static svc:L10n.I}}" IsChecked="{Binding StartWithWindows}" FontSize="12"
                                              ToolTip="{Binding [settings_start_with_windows_tip], Source={x:Static svc:L10n.I}}"/>
                                    <CheckBox Content="{Binding [settings_start_minimized], Source={x:Static svc:L10n.I}}" IsChecked="{Binding StartMinimized}" FontSize="12" Margin="24,6,0,0"
                                              IsEnabled="{Binding StartWithWindows}"/>
                                    <CheckBox Content="{Binding [settings_autostart_engine], Source={x:Static svc:L10n.I}}" IsChecked="{Binding AutoStartEngine}" FontSize="12" Margin="0,10,0,0"
                                              ToolTip="{Binding [settings_autostart_engine_tip], Source={x:Static svc:L10n.I}}"/>
                                    <CheckBox Content="{Binding [settings_close_to_tray], Source={x:Static svc:L10n.I}}" IsChecked="{Binding CloseToTray}" FontSize="12" Margin="0,6,0,0"
                                              ToolTip="{Binding [settings_close_to_tray_tip], Source={x:Static svc:L10n.I}}"/>
                                </StackPanel>
                            </Border>

                            <!-- Overlay -->
                            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding [settings_overlay], Source={x:Static svc:L10n.I}}" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="{Binding [overlay_intro], Source={x:Static svc:L10n.I}}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                    <CheckBox Content="{Binding [overlay_show], Source={x:Static svc:L10n.I}}" IsChecked="{Binding OverlayEnabled}" FontSize="12"/>
                                    <CheckBox Content="{Binding [overlay_lock], Source={x:Static svc:L10n.I}}" IsChecked="{Binding OverlayLocked}" FontSize="12" Margin="24,6,0,0"
                                              IsEnabled="{Binding OverlayEnabled}" ToolTip="{Binding [overlay_lock_tip], Source={x:Static svc:L10n.I}}"/>
                                    <TextBlock Style="{StaticResource SectionLabel}" Margin="0,10,0,0"><TextBlock.Text><MultiBinding Converter="{StaticResource LocFmt}"><Binding Path="[fmt_overlay_size]" Source="{x:Static svc:L10n.I}"/><Binding Path="OverlayScale"/></MultiBinding></TextBlock.Text></TextBlock>
                                    <Slider Minimum="0.5" Maximum="1.6" Value="{Binding OverlayScale}" Foreground="#06B6D4" TickFrequency="0.1" IsSnapToTickEnabled="True" IsEnabled="{Binding OverlayEnabled}"/>
                                    <TextBlock Style="{StaticResource SectionLabel}" Margin="0,6,0,0"><TextBlock.Text><MultiBinding Converter="{StaticResource LocFmt}"><Binding Path="[fmt_overlay_opacity]" Source="{x:Static svc:L10n.I}"/><Binding Path="OverlayOpacity"/></MultiBinding></TextBlock.Text></TextBlock>
                                    <Slider Minimum="0.2" Maximum="1.0" Value="{Binding OverlayOpacity}" Foreground="#06B6D4" TickFrequency="0.05" IsSnapToTickEnabled="True" IsEnabled="{Binding OverlayEnabled}"/>
                                    <Button Content="{Binding [overlay_reset], Source={x:Static svc:L10n.I}}" Command="{Binding ResetOverlayPositionCommand}" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0" IsEnabled="{Binding OverlayEnabled}"/>
                                    <TextBlock Text="{Binding [overlay_fullscreen_note], Source={x:Static svc:L10n.I}}" FontSize="11" Foreground="#F59E0B" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Updates -->
                            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding [settings_updates], Source={x:Static svc:L10n.I}}" Style="{StaticResource SectionLabel}"/>
                                    <CheckBox Content="{Binding [settings_check_updates_startup], Source={x:Static svc:L10n.I}}" IsChecked="{Binding CheckUpdatesAtStartup}" FontSize="12" Margin="0,4,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding [btn_check_now], Source={x:Static svc:L10n.I}}" Command="{Binding CheckUpdatesCommand}" Style="{StaticResource GhostButtonStyle}"/>
                                        <TextBlock Text="{Binding UpdateStatusText}" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <Button Content="{Binding [btn_download_update], Source={x:Static svc:L10n.I}}" Command="{Binding OpenUpdateCommand}" Style="{StaticResource ActionButtonStyle}" Height="30" Margin="12,0,0,0"
                                                Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Drivers -->
                            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding [settings_drivers], Source={x:Static svc:L10n.I}}" Style="{StaticResource SectionLabel}"/>
                                        <Button Grid.Column="1" Content="{Binding [btn_refresh], Source={x:Static svc:L10n.I}}" Command="{Binding RefreshDriversCommand}" Style="{StaticResource GhostButtonStyle}" VerticalAlignment="Top"/>
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="ViGEmBus" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ViGEmStatusText}" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding [vigem_desc], Source={x:Static svc:L10n.I}}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Button Grid.Row="0" Grid.Column="3" Content="{Binding [btn_download_page], Source={x:Static svc:L10n.I}}" Command="{Binding OpenViGEmPageCommand}" Style="{StaticResource GhostButtonStyle}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="HidHide" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HidHideStatusText}" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding [hidhide_desc], Source={x:Static svc:L10n.I}}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,8,12,0"/>
                                        <Button Grid.Row="1" Grid.Column="3" Content="{Binding [btn_download_page], Source={x:Static svc:L10n.I}}" Command="{Binding OpenHidHidePageCommand}" Style="{StaticResource GhostButtonStyle}" Margin="0,8,0,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [hidhide_cfg_label], Source={x:Static svc:L10n.I}}" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HidHideConfigText}" FontSize="12" Foreground="#38BDF8" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding [hidhide_cfg_desc], Source={x:Static svc:L10n.I}}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,8,12,0"/>
                                        <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                            <Button Content="{Binding [btn_hide_pad], Source={x:Static svc:L10n.I}}" Command="{Binding HidePadCommand}" IsEnabled="{Binding CanConfigureHidHide}" Style="{StaticResource GhostButtonStyle}"/>
                                            <Button Content="{Binding [btn_unhide_pad], Source={x:Static svc:L10n.I}}" Command="{Binding UnhidePadCommand}" IsEnabled="{Binding CanConfigureHidHide}" Style="{StaticResource GhostButtonStyle}" Margin="6,0,0,0"
                                                    Visibility="{Binding HidHideConfigured, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- About -->
                            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding [settings_about], Source={x:Static svc:L10n.I}}" Style="{StaticResource SectionLabel}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                                        <TextBlock Text="Wolverine Remapper" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding AppVersion}" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding [about_text], Source={x:Static svc:L10n.I}}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding [btn_github], Source={x:Static svc:L10n.I}}" Command="{Binding OpenGitHubCommand}" Style="{StaticResource GhostButtonStyle}"/>
                                        <Button Content="{Binding [guide_show], Source={x:Static svc:L10n.I}}" Command="{Binding ShowGuideCommand}" Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- ═══════════ CONSOLE ═══════════ -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding [console], Source={x:Static svc:L10n.I}}" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusMessage, StringFormat='  —  {0}'}" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding [clear], Source={x:Static svc:L10n.I}}" Command="{Binding ClearLogsCommand}" Style="{StaticResource GhostButtonStyle}" Padding="8,3" FontSize="10"/>
                    </Grid>
                    <ListBox ItemsSource="{Binding ActivityLogs}" Background="#0F172A" BorderBrush="#334155" BorderThickness="1"
                             Foreground="#38BDF8" FontFamily="Consolas" FontSize="11" Padding="6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="4,1"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══════════ KEY-CAPTURE OVERLAY ═══════════ -->
        <Grid Background="#D90F172A" Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,32" BorderBrush="#06B6D4">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock  FontSize="22" FontWeight="Black" Foreground="#06B6D4" HorizontalAlignment="Center"><TextBlock.Text><MultiBinding Converter="{StaticResource LocFmt}"><Binding Path="[fmt_rebinding]" Source="{x:Static svc:L10n.I}"/><Binding Path="CapturingButtonName"/></MultiBinding></TextBlock.Text></TextBlock>
                    <TextBlock Text="{Binding [press_the_key_your_controller], Source={x:Static svc:L10n.I}}" FontSize="14" Foreground="#F8FAFC" Margin="0,14,0,4" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding [press_m_buttons_on_the], Source={x:Static svc:L10n.I}}" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                    <Button Content="{Binding [cancel_esc], Source={x:Static svc:L10n.I}}" Command="{Binding CancelCaptureCommand}" Style="{StaticResource GhostButtonStyle}" Margin="0,20,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════ STICK-CAPTURE OVERLAY ═══════════ -->
        <Grid Background="#D90F172A" Visibility="{Binding IsCapturingStick, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="48,36" BorderBrush="#10B981">
                <StackPanel HorizontalAlignment="Center" Width="400">
                    <TextBlock Text="{Binding StickCaptureTitle}" FontSize="22" FontWeight="Black" Foreground="#10B981" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding [push_and_hold_the_stick], Source={x:Static svc:L10n.I}}" FontSize="14" Foreground="#F8FAFC" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding StickCaptureLive}" FontSize="32" FontWeight="Bold" Foreground="#06B6D4" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,16,0,2"/>
                    <TextBlock Text="{Binding StickCaptureBest}" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" MinHeight="16"/>
                    <ProgressBar Style="{StaticResource TriggerBar}" Maximum="100" Value="{Binding StickCaptureProgress, Mode=OneWay}" Foreground="#10B981" Margin="0,16,0,0"/>
                    <TextBlock Text="{Binding [the_strongest_push_wins_hold], Source={x:Static svc:L10n.I}}" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <Button Content="{Binding [cancel], Source={x:Static svc:L10n.I}}" Command="{Binding CancelStickCaptureCommand}" Style="{StaticResource GhostButtonStyle}" Margin="0,18,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════ MACRO-RECORDER OVERLAY ═══════════ -->
        <Grid Background="#D90F172A" Visibility="{Binding IsRecordingMacro, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="48,36" BorderBrush="#F43F5E">
                <StackPanel HorizontalAlignment="Center" Width="440">
                    <TextBlock Text="{Binding RecordTitle}" FontSize="22" FontWeight="Black" Foreground="#F43F5E" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding RecordDetail}" FontSize="14" Foreground="#F8FAFC" Margin="0,12,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    <!-- Live pad so the player sees every input light up while recording -->
                    <views:PadView Width="360" Margin="0,12,0,0"/>
                    <TextBlock Text="{Binding RecordBig}" FontSize="40" FontWeight="Bold" Foreground="#06B6D4" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,6,0,4"/>
                    <TextBlock Text="{Binding [record_hint], Source={x:Static svc:L10n.I}}" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button Content="{Binding [btn_stop_recording], Source={x:Static svc:L10n.I}}" Command="{Binding StopRecordingCommand}"
                                Style="{StaticResource ActionButtonStyle}" Height="36" Width="200"
                                Visibility="{Binding IsRecordingLive, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="{Binding [cancel], Source={x:Static svc:L10n.I}}" Command="{Binding CancelRecordingCommand}" Style="{StaticResource GhostButtonStyle}" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════ FIRST-RUN GUIDE OVERLAY ═══════════ -->
        <Grid Background="#E60F172A" Visibility="{Binding IsGuideOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="36,28" BorderBrush="#22D3EE" Width="760" MaxHeight="640">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding [guide_heading], Source={x:Static svc:L10n.I}}" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding GuidePageTitle}" FontSize="20" FontWeight="Black" Foreground="#22D3EE" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <TextBlock Text="🌐" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Style="{StaticResource DarkCombo}" Width="130" Margin="0,0,14,0" VerticalAlignment="Center"
                                      ItemsSource="{Binding Languages}" SelectedItem="{Binding CurrentLanguage, Mode=TwoWay}"
                                      ToolTip="{Binding [ui_language_tip], Source={x:Static svc:L10n.I}}"/>
                            <TextBlock Text="{Binding GuidePageCounter}" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Content="✕" Command="{Binding CloseGuideCommand}" Style="{StaticResource GhostButtonStyle}" Width="34" Padding="0"
                                    ToolTip="{Binding [guide_skip], Source={x:Static svc:L10n.I}}"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBlock local:MarkupText.Text="{Binding GuidePageBody}" FontSize="14" Foreground="#E2E8F0" TextWrapping="Wrap" LineHeight="22"/>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="{Binding [guide_back], Source={x:Static svc:L10n.I}}" Command="{Binding GuideBackCommand}" Style="{StaticResource GhostButtonStyle}"
                                Visibility="{Binding GuideIsFirstPage, Converter={StaticResource InvBoolToVis}}"/>
                        <Button Grid.Column="2" Content="{Binding [guide_next], Source={x:Static svc:L10n.I}}" Command="{Binding GuideNextCommand}" Style="{StaticResource ActionButtonStyle}" Height="36" MinWidth="150"
                                Visibility="{Binding GuideIsNotLastPage, Converter={StaticResource BoolToVis}}"/>
                        <Button Grid.Column="2" Content="{Binding [guide_done], Source={x:Static svc:L10n.I}}" Command="{Binding CloseGuideCommand}" Style="{StaticResource ActionButtonStyle}" Height="36" MinWidth="150"
                                Visibility="{Binding GuideIsLastPage, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
