                                        <Button Canvas.Left="8"   Canvas.Top="314" Style="{StaticResource CalloutStyle}" DataContext="{Binding M3}"/>
                                        <Button Canvas.Left="8"   Canvas.Top="388" Style="{StaticResource CalloutStyle}" DataContext="{Binding M5}"/>
                                        <Button Canvas.Left="470" Canvas.Top="314" Style="{StaticResource CalloutStyle}" DataContext="{Binding M4}"/>
                                        <Button Canvas.Left="470" Canvas.Top="388" Style="{StaticResource CalloutStyle}" DataContext="{Binding M6}"/>
                                    </Canvas>
                                </Viewbox>
                            </DockPanel>
                        </Border>

                        <!-- Chord configurator -->
                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16">
