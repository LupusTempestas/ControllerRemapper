                                    <ProgressBar Grid.Column="4" Style="{StaticResource TriggerBar}" Value="{Binding RightTriggerValue, Mode=OneWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="{Binding RightTriggerValue, StringFormat='{}{0:F0}'}" FontSize="11" FontFamily="Consolas" Foreground="#94A3B8" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="24"/>
                                </Grid>
                                <Viewbox Stretch="Uniform">
                                    <Canvas Width="620" Height="470">

