                                        </Border>
                                        <Border Canvas.Left="380" Canvas.Top="8" Width="72" Height="20" CornerRadius="10"
                                                Background="{Binding IsRTPressed, Converter={StaticResource PressedBrush}}">
                                            <TextBlock Text="RT" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Bumpers -->
                                        <Border Canvas.Left="158" Canvas.Top="36" Width="78" Height="22" CornerRadius="8"
                                                Background="{Binding IsLBPressed, Converter={StaticResource PressedBrush}}">
                                            <TextBlock Text="LB" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Canvas.Left="384" Canvas.Top="36" Width="78" Height="22" CornerRadius="8"
                                                Background="{Binding IsRBPressed, Converter={StaticResource PressedBrush}}">
                                            <TextBlock Text="RB" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- M1 / M2 extra bumpers -->
                                        <Button Canvas.Left="246" Canvas.Top="34" Style="{StaticResource MBadgeStyle}" DataContext="{Binding M1}"/>
                                        <Button Canvas.Left="322" Canvas.Top="34" Style="{StaticResource MBadgeStyle}" DataContext="{Binding M2}"/>

                                        <!-- Body -->
                                        <Path Fill="#111C2E" Stroke="#334155" StrokeThickness="3"
                                              Data="M 310,90 C 250,84 200,88 168,104 C 120,128 92,190 84,258 C 76,330 88,392 122,408 C 156,424 190,398 210,362 C 232,326 262,312 310,312 C 358,312 388,326 410,362 C 430,398 464,424 498,408 C 532,392 544,330 536,258 C 528,190 500,128 452,104 C 420,88 370,84 310,90 Z"/>

                                        <!-- Left stick (nub follows real deflection) -->
                                        <Ellipse Canvas.Left="132" Canvas.Top="157" Width="76" Height="76" Fill="#0F172A" Stroke="#06B6D4" StrokeThickness="2"/>
                                        <Ellipse Canvas.Left="150" Canvas.Top="175" Width="40" Height="40"
                                                 Fill="{Binding IsLSPressed, Converter={StaticResource PressedBrush}}"
                                                 Stroke="#475569" StrokeThickness="2">
                                            <Ellipse.RenderTransform>
                                                <TranslateTransform X="{Binding LeftStickXNorm, Converter={StaticResource Scale}, ConverterParameter='16'}"
                                                                    Y="{Binding LeftStickYNorm, Converter={StaticResource Scale}, ConverterParameter='-16'}"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>

                                        <!-- Right stick -->
                                        <Ellipse Canvas.Left="352" Canvas.Top="234" Width="76" Height="76" Fill="#0F172A" Stroke="#06B6D4" StrokeThickness="2"/>
                                        <Ellipse Canvas.Left="370" Canvas.Top="252" Width="40" Height="40"
                                                 Fill="{Binding IsRSPressed, Converter={StaticResource PressedBrush}}"
                                                 Stroke="#475569" StrokeThickness="2">
                                            <Ellipse.RenderTransform>
                                                <TranslateTransform X="{Binding RightStickXNorm, Converter={StaticResource Scale}, ConverterParameter='16'}"
                                                                    Y="{Binding RightStickYNorm, Converter={StaticResource Scale}, ConverterParameter='-16'}"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>

                                        <!-- D-pad -->
                                        <Rectangle Canvas.Left="213" Canvas.Top="227" Width="30" Height="32" RadiusX="4" RadiusY="4"
                                                   Fill="{Binding IsDPadUpPressed, Converter={StaticResource PressedBrush}}"/>
                                        <Rectangle Canvas.Left="213" Canvas.Top="285" Width="30" Height="32" RadiusX="4" RadiusY="4"
                                                   Fill="{Binding IsDPadDownPressed, Converter={StaticResource PressedBrush}}"/>
                                        <Rectangle Canvas.Left="181" Canvas.Top="257" Width="32" Height="30" RadiusX="4" RadiusY="4"
                                                   Fill="{Binding IsDPadLeftPressed, Converter={StaticResource PressedBrush}}"/>
                                        <Rectangle Canvas.Left="243" Canvas.Top="257" Width="32" Height="30" RadiusX="4" RadiusY="4"
                                                   Fill="{Binding IsDPadRightPressed, Converter={StaticResource PressedBrush}}"/>
                                        <Rectangle Canvas.Left="213" Canvas.Top="257" Width="30" Height="30" Fill="#334155"/>

                                        <!-- Face buttons -->
                                        <Border Canvas.Left="434" Canvas.Top="141" Width="36" Height="36" CornerRadius="18"
                                                Background="{Binding IsYPressed, Converter={StaticResource PressedBrush}}">
                                            <TextBlock Text="Y" FontWeight="Bold" Foreground="#FACC15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Canvas.Left="398" Canvas.Top="177" Width="36" Height="36" CornerRadius="18"
                                                Background="{Binding IsXPressed, Converter={StaticResource PressedBrush}}">
                                            <TextBlock Text="X" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Canvas.Left="470" Canvas.Top="177" Width="36" Height="36" CornerRadius="18"
                                                Background="{Binding IsBPressed, Converter={StaticResource PressedBrush}}">
                                            <TextBlock Text="B" FontWeight="Bold" Foreground="#F87171" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Canvas.Left="434" Canvas.Top="213" Width="36" Height="36" CornerRadius="18"
                                                Background="{Binding IsAPressed, Converter={StaticResource PressedBrush}}">
                                            <TextBlock Text="A" FontWeight="Bold" Foreground="#4ADE80" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- View / Menu -->
                                        <Border Canvas.Left="272" Canvas.Top="160" Width="24" Height="24" CornerRadius="12"
                                                Background="{Binding IsViewPressed, Converter={StaticResource PressedBrush}}"
                                                ToolTip="View"/>
                                        <Border Canvas.Left="324" Canvas.Top="160" Width="24" Height="24" CornerRadius="12"
                                                Background="{Binding IsMenuPressed, Converter={StaticResource PressedBrush}}"
                                                ToolTip="Menu"/>

                                        <!-- Back paddles -->
                                        <Button Canvas.Left="196" Canvas.Top="330" Style="{StaticResource MBadgeStyle}" DataContext="{Binding M3}"/>
                                        <Button Canvas.Left="176" Canvas.Top="364" Style="{StaticResource MBadgeStyle}" DataContext="{Binding M5}"/>
                                        <Button Canvas.Left="376" Canvas.Top="330" Style="{StaticResource MBadgeStyle}" DataContext="{Binding M4}"/>
                                        <Button Canvas.Left="396" Canvas.Top="364" Style="{StaticResource MBadgeStyle}" DataContext="{Binding M6}"/>

                                        <!-- Callout lines -->
                                        <Line X1="248" Y1="45" X2="152" Y2="32" Stroke="#10B981" StrokeThickness="1.5" StrokeDashArray="4 2"/>
                                        <Line X1="372" Y1="45" X2="468" Y2="32" Stroke="#10B981" StrokeThickness="1.5" StrokeDashArray="4 2"/>
                                        <Line X1="196" Y1="340" X2="152" Y2="332" Stroke="#10B981" StrokeThickness="1.5" StrokeDashArray="4 2"/>
                                        <Line X1="176" Y1="374" X2="152" Y2="402" Stroke="#10B981" StrokeThickness="1.5" StrokeDashArray="4 2"/>
                                        <Line X1="424" Y1="340" X2="468" Y2="332" Stroke="#10B981" StrokeThickness="1.5" StrokeDashArray="4 2"/>
                                        <Line X1="444" Y1="374" X2="468" Y2="402" Stroke="#10B981" StrokeThickness="1.5" StrokeDashArray="4 2"/>

                                        <!-- Callout badges (live key + chord, clickable) -->
                                        <Button Canvas.Left="8"   Canvas.Top="12"  Style="{StaticResource CalloutStyle}" DataContext="{Binding M1}"/>
                                        <Button Canvas.Left="470" Canvas.Top="12"  Style="{StaticResource CalloutStyle}" DataContext="{Binding M2}"/>
                                        <Button Canvas.Left="8"   Canvas.Top="314" Style="{StaticResource CalloutStyle}" DataContext="{Binding M3}"/>
                                        <Button Canvas.Left="8"   Canvas.Top="388" Style="{StaticResource CalloutStyle}" DataContext="{Binding M5}"/>
                                        <Button Canvas.Left="470" Canvas.Top="314" Style="{StaticResource CalloutStyle}" DataContext="{Binding M4}"/>
                                        <Button Canvas.Left="470" Canvas.Top="388" Style="{StaticResource CalloutStyle}" DataContext="{Binding M6}"/>
                                    </Canvas>
                                </Viewbox>
                            </DockPanel>
                        </Border>

                        <!-- Chord configurator -->
                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16">
                            <Grid DataContext="{Binding SelectedMButton}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MButtonName, StringFormat='CONFIGURING {0}'}" FontSize="17" FontWeight="Bold" Foreground="#06B6D4"/>
                                                <Border Background="#1E293B" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TriggerDisplayName}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- V3: capture a keyboard key -->
                                            <Button Grid.Column="1" Content="⌨ REBIND KEY"
                                                    Visibility="{Binding IsKeyboardTrigger, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.RebindCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource GhostButtonStyle}"/>

                                            <!-- V2: pick the pad button this paddle sacrifices -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                        Visibility="{Binding IsPadTrigger, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="SACRIFICED BUTTON" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"
                                                           ToolTip="The real pad button the paddle is mapped to in Razer's software. It becomes this M-button's trigger and is no longer usable in-game."/>
                                                <ComboBox Style="{StaticResource DarkCombo}" Width="130"
                                                          ItemsSource="{Binding DataContext.PadTriggerChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="Label" SelectedValuePath="Id"
                                                          SelectedValue="{Binding PadTriggerButton, Mode=TwoWay}"/>
                                            </StackPanel>
                                        </Grid>
                                        <CheckBox Content="Swallow key from Windows &amp; games (stops UI-mode flip)"
                                                  IsChecked="{Binding SuppressKey}" FontSize="12" Margin="0,10,0,0"
                                                  Visibility="{Binding IsKeyboardTrigger, Converter={StaticResource BoolToVis}}"
                                                  ToolTip="While the engine runs, this key is invisible to Windows and every app — the game never sees a keyboard press, so it stays in controller UI."/>
                                        <StackPanel Visibility="{Binding IsPadTrigger, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                                            <TextBlock Text="{Binding DataContext.PadTriggerHint, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                                            <TextBlock Text="⚠ Passthrough is OFF — the sacrificed button still reaches the game. Turn Passthrough ON in the profile bar."
                                                       FontSize="11" FontWeight="Bold" Foreground="#F59E0B" TextWrapping="Wrap" Margin="0,6,0,0"
                                                       Visibility="{Binding DataContext.ShowPadModeWarning, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <!-- Trigger type selector -->
                                        <TextBlock Text="TRIGGER — HOW THE M-BUTTON ACTIVATES" Style="{StaticResource SectionLabel}"/>
                                        <WrapPanel Margin="0,0,0,4">
                                            <RadioButton Content="HOLD" IsChecked="{Binding IsHoldTrigger}" Style="{StaticResource PillToggleStyle}"
                                                         ToolTip="Action is active while you hold the M-button. Let go and it ends. (Default.)"/>
                                            <RadioButton Content="TOGGLE" IsChecked="{Binding IsToggleTrigger}" Style="{StaticResource PillToggleStyle}"
                                                         ToolTip="Press once to latch the action ON (hands-free), press again to turn it OFF. Great for sprint-lock, aim-lock, or toggled auto-fire."/>
                                            <RadioButton Content="DOUBLE-TAP" IsChecked="{Binding IsDoubleTapTrigger}" Style="{StaticResource PillToggleStyle}"
                                                         ToolTip="Two quick presses toggle the action on/off; a single press does nothing. Fires instantly on the second tap — no added lag."/>
                                        </WrapPanel>
                                        <StackPanel Visibility="{Binding IsDoubleTapTrigger, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding DoubleTapWindowMs, StringFormat='MAX GAP BETWEEN TAPS — {0} ms'}" Style="{StaticResource SectionLabel}"/>
                                            <Slider Minimum="150" Maximum="600" Value="{Binding DoubleTapWindowMs}" Foreground="#06B6D4" TickFrequency="10" IsSnapToTickEnabled="True"/>
                                        </StackPanel>
                                        <Border Height="1" Background="#334155" Margin="0,8,0,12"/>

                                        <!-- Repeat selector (applies to every action type) -->
                                        <TextBlock Text="REPEAT — HOW MANY TIMES" Style="{StaticResource SectionLabel}"/>
                                        <WrapPanel Margin="0,0,0,4">
                                            <RadioButton Content="ONCE" IsChecked="{Binding IsRepeatOnce}" Style="{StaticResource PillToggleStyle}"
                                                         ToolTip="Run the action a single time (or, for a chord, simply hold it)."/>
                                            <RadioButton Content="MULTIPLE TIMES" IsChecked="{Binding IsRepeatCount}" Style="{StaticResource PillToggleStyle}"
                                                         ToolTip="Fire the action a set number of times, then stop — even on a quick press. Pick the count below."/>
                                            <RadioButton Content="WHILE HELD" IsChecked="{Binding IsRepeatWhileHeld}" Style="{StaticResource PillToggleStyle}"
                                                         ToolTip="Repeat continuously until you release (or toggle off). This is turbo / auto-fire."/>
                                        </WrapPanel>
                                        <StackPanel Visibility="{Binding IsRepeatCount, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding RepeatCount, StringFormat='HOW MANY TIMES — {0}'}" Style="{StaticResource SectionLabel}"/>
                                            <Slider Minimum="2" Maximum="20" Value="{Binding RepeatCount}" Foreground="#06B6D4" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding IsRepeatOnce, Converter={StaticResource InvBoolToVis}}" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding RepeatGapMs, StringFormat='SPEED — {0} ms between repeats'}" Style="{StaticResource SectionLabel}"/>
                                            <Slider Minimum="20" Maximum="300" Value="{Binding RepeatGapMs}" Foreground="#06B6D4" TickFrequency="5" IsSnapToTickEnabled="True"/>
                                        </StackPanel>
                                        <Border Height="1" Background="#334155" Margin="0,8,0,12"/>

                                        <!-- Action mode selector -->
                                        <TextBlock Text="ACTION TYPE — WHAT IT SENDS" Style="{StaticResource SectionLabel}"/>
                                        <WrapPanel Margin="0,0,0,12">
                                            <RadioButton Content="CHORD (all at once)" IsChecked="{Binding IsChordMode}" Style="{StaticResource PillToggleStyle}"
                                                         ToolTip="All selected buttons press together on key-down and release together on key-up."/>
                                            <RadioButton Content="HOLD + PRESS" IsChecked="{Binding IsHoldTapMode}" Style="{StaticResource PillToggleStyle}"
                                                         ToolTip="Hold the first set, wait, then press the second set while still holding. Everything releases when you let go."/>
                                            <RadioButton Content="MACRO (sequence)" IsChecked="{Binding IsSequenceMode}" Style="{StaticResource PillToggleStyle}"
                                                         ToolTip="Build your own ordered sequence of press / release / tap / wait steps."/>
                                        </WrapPanel>

                                        <!-- ══ CHORD MODE ══ -->
                                        <StackPanel Visibility="{Binding IsChordMode, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="FACE BUTTONS" Style="{StaticResource SectionLabel}"/>
                                            <WrapPanel Margin="0,0,0,10">
                                                <ToggleButton Content="A" IsChecked="{Binding A}" Style="{StaticResource PillToggleStyle}" Width="68"/>
                                                <ToggleButton Content="B" IsChecked="{Binding B}" Style="{StaticResource PillToggleStyle}" Width="68"/>
                                                <ToggleButton Content="X" IsChecked="{Binding X}" Style="{StaticResource PillToggleStyle}" Width="68"/>
                                                <ToggleButton Content="Y" IsChecked="{Binding Y}" Style="{StaticResource PillToggleStyle}" Width="68"/>
                                            </WrapPanel>

                                            <TextBlock Text="SHOULDERS &amp; TRIGGERS" Style="{StaticResource SectionLabel}"/>
                                            <WrapPanel Margin="0,0,0,10">
                                                <ToggleButton Content="LB" IsChecked="{Binding LB}" Style="{StaticResource PillToggleStyle}" Width="68"/>
                                                <ToggleButton Content="RB" IsChecked="{Binding RB}" Style="{StaticResource PillToggleStyle}" Width="68"/>
                                                <ToggleButton Content="LT" IsChecked="{Binding LT}" Style="{StaticResource PillToggleStyle}" Width="68"/>
                                                <ToggleButton Content="RT" IsChecked="{Binding RT}" Style="{StaticResource PillToggleStyle}" Width="68"/>
                                            </WrapPanel>

                                            <TextBlock Text="D-PAD" Style="{StaticResource SectionLabel}"/>
                                            <WrapPanel Margin="0,0,0,10">
                                                <ToggleButton Content="▲ Up" IsChecked="{Binding DPadUp}" Style="{StaticResource PillToggleStyle}" Width="86"/>
                                                <ToggleButton Content="▼ Down" IsChecked="{Binding DPadDown}" Style="{StaticResource PillToggleStyle}" Width="86"/>
                                                <ToggleButton Content="◀ Left" IsChecked="{Binding DPadLeft}" Style="{StaticResource PillToggleStyle}" Width="86"/>
                                                <ToggleButton Content="▶ Right" IsChecked="{Binding DPadRight}" Style="{StaticResource PillToggleStyle}" Width="86"/>
                                            </WrapPanel>

                                            <TextBlock Text="STICKS &amp; SYSTEM" Style="{StaticResource SectionLabel}"/>
                                            <WrapPanel Margin="0,0,0,10">
                                                <ToggleButton Content="LS Click" IsChecked="{Binding LSClick}" Style="{StaticResource PillToggleStyle}" Width="86"/>
                                                <ToggleButton Content="RS Click" IsChecked="{Binding RSClick}" Style="{StaticResource PillToggleStyle}" Width="86"/>
                                                <ToggleButton Content="View" IsChecked="{Binding View}" Style="{StaticResource PillToggleStyle}" Width="86"/>
                                                <ToggleButton Content="Menu" IsChecked="{Binding Menu}" Style="{StaticResource PillToggleStyle}" Width="86"/>
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- ══ HOLD + PRESS MODE ══ -->
                                        <StackPanel Visibility="{Binding IsHoldTapMode, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="STEP 1 — HOLD THESE FIRST" Style="{StaticResource SectionLabel}"/>
                                            <ItemsControl ItemsSource="{Binding HoldPicks}" Margin="0,0,0,10">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ToggleButton Content="{Binding Id, Converter={StaticResource ButtonName}}" IsChecked="{Binding IsSelected}" Style="{StaticResource PillToggleStyle}" MinWidth="64"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="STEP 2 — THEN PRESS (WHILE STILL HOLDING)" Style="{StaticResource SectionLabel}"/>
                                            <ItemsControl ItemsSource="{Binding TapPicks}" Margin="0,0,0,10">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ToggleButton Content="{Binding Id, Converter={StaticResource ButtonName}}" IsChecked="{Binding IsSelected}" Style="{StaticResource PillToggleStyle}" MinWidth="64"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="{Binding HoldTapDelayMs, StringFormat='DELAY BETWEEN STEPS — {0} ms'}" Style="{StaticResource SectionLabel}"/>
                                            <Slider Minimum="20" Maximum="500" Value="{Binding HoldTapDelayMs}" Foreground="#06B6D4"
                                                    TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,0,0,8"/>
                                            <TextBlock Text="Everything releases when you let go of the M-button." FontSize="11" Foreground="#94A3B8"/>
                                        </StackPanel>

                                        <!-- ══ MACRO MODE ══ -->
                                        <StackPanel Visibility="{Binding IsSequenceMode, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="ADD A STEP" Style="{StaticResource SectionLabel}"/>
                                            <WrapPanel Margin="0,0,0,10">
                                                <Button Content="+ PRESS" Style="{StaticResource GhostButtonStyle}" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.AddStepCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Press"
                                                        ToolTip="Press a button and keep holding it"/>
                                                <Button Content="+ RELEASE" Style="{StaticResource GhostButtonStyle}" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.AddStepCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Release"
                                                        ToolTip="Release a button pressed earlier in the sequence"/>
                                                <Button Content="+ TAP" Style="{StaticResource GhostButtonStyle}" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.AddStepCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Tap"
                                                        ToolTip="Press, hold briefly, release — one quick click"/>
                                                <Button Content="+ WAIT" Style="{StaticResource GhostButtonStyle}" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.AddStepCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Wait"
                                                        ToolTip="Pause between steps"/>
                                                <Button Content="+ PUSH STICK" Style="{StaticResource GhostButtonStyle}" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.AddStepCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="PushStick"
                                                        ToolTip="Hold a thumbstick at a recorded position (ring menus, movement) until Center Stick or key release"/>
                                                <Button Content="+ CENTER STICK" Style="{StaticResource GhostButtonStyle}"
                                                        Command="{Binding DataContext.AddStepCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="CenterStick"
                                                        ToolTip="Recenter a thumbstick pushed earlier in the sequence"/>
                                            </WrapPanel>

                                            <ItemsControl ItemsSource="{Binding Steps}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#0F172A" CornerRadius="6" BorderBrush="#334155" BorderThickness="1" Padding="8,6" Margin="0,0,0,6">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="106"/>
                                                                        <ColumnDefinition Width="110"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <ComboBox Grid.Column="0" Style="{StaticResource DarkCombo}" Margin="0,0,8,0"
                                                                              ItemsSource="{Binding DataContext.MacroStepTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                              SelectedItem="{Binding Type}"/>
                                                                    <Grid Grid.Column="1" Margin="0,0,8,0">
                                                                        <ComboBox Style="{StaticResource DarkCombo}"
                                                                                  ItemsSource="{Binding DataContext.VirtualButtons, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                  SelectedItem="{Binding Button}"
                                                                                  Visibility="{Binding UsesButton, Converter={StaticResource BoolToVis}}"/>
                                                                        <ComboBox Style="{StaticResource DarkCombo}"
                                                                                  ItemsSource="{Binding DataContext.StickSides, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                  SelectedItem="{Binding Stick}"
                                                                                  Visibility="{Binding UsesStick, Converter={StaticResource BoolToVis}}"/>
                                                                    </Grid>
                                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                                                Visibility="{Binding UsesDuration, Converter={StaticResource BoolToVis}}">
                                                                        <TextBox Style="{StaticResource DarkTextBox}" Width="54"
                                                                                 Text="{Binding DurationMs, UpdateSourceTrigger=PropertyChanged}"/>
                                                                        <TextBlock Text="ms" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                                                                        <Button Content="▲" Style="{StaticResource GhostButtonStyle}" Padding="7,4" Margin="0,0,4,0"
                                                                                Command="{Binding DataContext.MoveStepUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                                        <Button Content="▼" Style="{StaticResource GhostButtonStyle}" Padding="7,4" Margin="0,0,4,0"
                                                                                Command="{Binding DataContext.MoveStepDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                                        <Button Content="✕" Style="{StaticResource GhostButtonStyle}" Padding="7,4"
                                                                                Command="{Binding DataContext.RemoveStepCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                                    </StackPanel>
                                                                </Grid>

                                                                <!-- Stick position sub-row (PushStick only) -->
                                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                                            Visibility="{Binding UsesStickPosition, Converter={StaticResource BoolToVis}}">
                                                                    <Button Content="⦿ CAPTURE POSITION" Style="{StaticResource GhostButtonStyle}" Margin="0,0,10,0"
                                                                            Command="{Binding DataContext.CaptureStickCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                            ToolTip="Click, then push the physical stick toward the target for 2 seconds — the strongest deflection is saved"/>
                                                                    <TextBlock Text="X" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                    <TextBox Style="{StaticResource DarkTextBox}" Width="52" Margin="0,0,8,0"
                                                                             Text="{Binding StickX, StringFormat=F3, UpdateSourceTrigger=LostFocus}"/>
                                                                    <TextBlock Text="Y" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                    <TextBox Style="{StaticResource DarkTextBox}" Width="52" Margin="0,0,10,0"
                                                                             Text="{Binding StickY, StringFormat=F3, UpdateSourceTrigger=LostFocus}"/>
                                                                    <TextBlock Text="{Binding StickSummary}" FontSize="11" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="A started macro always runs to completion — even a quick tap plays the whole combo. Buttons still held when it ends stay held until you release the M-button."
                                                       FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <Border Grid.Row="2" Background="#0F172A" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="OUTPUT:" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ChordSummary}" FontSize="14" FontWeight="Bold" Foreground="#10B981" Margin="8,0,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ── TAB 3: STICK ANALYZER ── -->
                <TabItem Header="🎯  STICK &amp; DEADZONE ANALYZER">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left stick radar -->
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,8,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="LEFT THUMBSTICK" FontSize="13" FontWeight="Bold" Foreground="#06B6D4" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0" Width="280" HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding LeftStickXNorm, StringFormat='X  {0:F3}'}" FontSize="12" Foreground="#F8FAFC" FontFamily="Consolas"/>
                                        <TextBlock Text="{Binding LeftStickYNorm, StringFormat='Y  {0:F3}'}" FontSize="12" Foreground="#F8FAFC" FontFamily="Consolas"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding LeftStickMagnitude, StringFormat='Deflection  {0:F1}%'}" FontSize="12" FontWeight="Bold" Foreground="#10B981"/>
                                        <TextBlock Text="{Binding LeftStickDriftPercent, StringFormat='Drift at rest  {0:F2}%'}" FontSize="12" FontWeight="Bold" Foreground="#F43F5E"/>
                                    </StackPanel>
                                </Grid>
                                <Viewbox Stretch="Uniform">
                                <Canvas Width="200" Height="200" Background="#0F172A">
                                    <Ellipse Canvas.Left="7" Canvas.Top="7" Width="186" Height="186" Stroke="#334155" StrokeThickness="2"/>
                                    <Line X1="100" Y1="0" X2="100" Y2="200" Stroke="#1E293B" StrokeThickness="1"/>
                                    <Line X1="0" Y1="100" X2="200" Y2="100" Stroke="#1E293B" StrokeThickness="1"/>
                                    <!-- Outer saturation ring -->
                                    <Ellipse Stroke="#06B6D4" StrokeThickness="1" StrokeDashArray="4 3"
                                             Width="{Binding OuterDeadzone, Converter={StaticResource Scale}, ConverterParameter='1.86'}"
                                             Height="{Binding OuterDeadzone, Converter={StaticResource Scale}, ConverterParameter='1.86'}"
                                             Canvas.Left="{Binding OuterDeadzone, Converter={StaticResource Scale}, ConverterParameter='-0.93,100'}"
                                             Canvas.Top="{Binding OuterDeadzone, Converter={StaticResource Scale}, ConverterParameter='-0.93,100'}"/>
                                    <!-- Inner deadzone ring -->
                                    <Ellipse Stroke="#F43F5E" StrokeThickness="1" StrokeDashArray="3 2" Fill="#14F43F5E"
                                             Width="{Binding InnerDeadzone, Converter={StaticResource Scale}, ConverterParameter='1.86'}"
                                             Height="{Binding InnerDeadzone, Converter={StaticResource Scale}, ConverterParameter='1.86'}"
                                             Canvas.Left="{Binding InnerDeadzone, Converter={StaticResource Scale}, ConverterParameter='-0.93,100'}"
                                             Canvas.Top="{Binding InnerDeadzone, Converter={StaticResource Scale}, ConverterParameter='-0.93,100'}"/>
                                    <Ellipse Width="14" Height="14" Fill="#10B981" Stroke="#34D399" StrokeThickness="2"
                                             Canvas.Left="{Binding LeftStickCanvasX}" Canvas.Top="{Binding LeftStickCanvasY}"/>
                                </Canvas>
                                </Viewbox>
                            </DockPanel>
                        </Border>

                        <!-- Right stick radar -->
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Padding="16" Margin="8,0,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="RIGHT THUMBSTICK" FontSize="13" FontWeight="Bold" Foreground="#06B6D4" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0" Width="280" HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding RightStickXNorm, StringFormat='X  {0:F3}'}" FontSize="12" Foreground="#F8FAFC" FontFamily="Consolas"/>
                                        <TextBlock Text="{Binding RightStickYNorm, StringFormat='Y  {0:F3}'}" FontSize="12" Foreground="#F8FAFC" FontFamily="Consolas"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding RightStickMagnitude, StringFormat='Deflection  {0:F1}%'}" FontSize="12" FontWeight="Bold" Foreground="#10B981"/>
                                        <TextBlock Text="{Binding RightStickDriftPercent, StringFormat='Drift at rest  {0:F2}%'}" FontSize="12" FontWeight="Bold" Foreground="#F43F5E"/>
                                    </StackPanel>
                                </Grid>
                                <Viewbox Stretch="Uniform">
                                <Canvas Width="200" Height="200" Background="#0F172A">
                                    <Ellipse Canvas.Left="7" Canvas.Top="7" Width="186" Height="186" Stroke="#334155" StrokeThickness="2"/>
                                    <Line X1="100" Y1="0" X2="100" Y2="200" Stroke="#1E293B" StrokeThickness="1"/>
                                    <Line X1="0" Y1="100" X2="200" Y2="100" Stroke="#1E293B" StrokeThickness="1"/>
                                    <Ellipse Stroke="#06B6D4" StrokeThickness="1" StrokeDashArray="4 3"
                                             Width="{Binding OuterDeadzone, Converter={StaticResource Scale}, ConverterParameter='1.86'}"
                                             Height="{Binding OuterDeadzone, Converter={StaticResource Scale}, ConverterParameter='1.86'}"
                                             Canvas.Left="{Binding OuterDeadzone, Converter={StaticResource Scale}, ConverterParameter='-0.93,100'}"
                                             Canvas.Top="{Binding OuterDeadzone, Converter={StaticResource Scale}, ConverterParameter='-0.93,100'}"/>
                                    <Ellipse Stroke="#F43F5E" StrokeThickness="1" StrokeDashArray="3 2" Fill="#14F43F5E"
                                             Width="{Binding InnerDeadzone, Converter={StaticResource Scale}, ConverterParameter='1.86'}"
                                             Height="{Binding InnerDeadzone, Converter={StaticResource Scale}, ConverterParameter='1.86'}"
                                             Canvas.Left="{Binding InnerDeadzone, Converter={StaticResource Scale}, ConverterParameter='-0.93,100'}"
                                             Canvas.Top="{Binding InnerDeadzone, Converter={StaticResource Scale}, ConverterParameter='-0.93,100'}"/>
                                    <Ellipse Width="14" Height="14" Fill="#10B981" Stroke="#34D399" StrokeThickness="2"
                                             Canvas.Left="{Binding RightStickCanvasX}" Canvas.Top="{Binding RightStickCanvasY}"/>
                                </Canvas>
                                </Viewbox>
                            </DockPanel>
                        </Border>

                        <!-- Deadzone controls -->
                        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <TextBlock Text="{Binding InnerDeadzone, StringFormat='INNER DEADZONE — {0:F0}% (red ring: input below this is ignored)'}" Style="{StaticResource SectionLabel}"/>
                                    <Slider Minimum="0" Maximum="40" Value="{Binding InnerDeadzone}" Foreground="#F43F5E" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                    <TextBlock Text="{Binding OuterDeadzone, StringFormat='OUTER SATURATION — {0:F0}% (cyan ring: input beyond this counts as 100%)'}" Style="{StaticResource SectionLabel}"/>
                                    <Slider Minimum="60" Maximum="100" Value="{Binding OuterDeadzone}" Foreground="#06B6D4" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- ═══════════ CONSOLE ═══════════ -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="CONSOLE" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusMessage, StringFormat='  —  {0}'}" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="CLEAR" Command="{Binding ClearLogsCommand}" Style="{StaticResource GhostButtonStyle}" Padding="8,3" FontSize="10"/>
                    </Grid>
                    <ListBox ItemsSource="{Binding ActivityLogs}" Background="#0F172A" BorderBrush="#334155" BorderThickness="1"
                             Foreground="#38BDF8" FontFamily="Consolas" FontSize="11" Padding="6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="4,1"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══════════ KEY-CAPTURE OVERLAY ═══════════ -->
        <Grid Background="#D90F172A" Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,32" BorderBrush="#06B6D4">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding CapturingButtonName, StringFormat='REBINDING {0}'}" FontSize="22" FontWeight="Black" Foreground="#06B6D4" HorizontalAlignment="Center"/>
                    <TextBlock Text="Press the key your controller sends for this button…" FontSize="14" Foreground="#F8FAFC" Margin="0,14,0,4" HorizontalAlignment="Center"/>
                    <TextBlock Text="(Press M-buttons on the pad after mapping them to F13–F18 in Synapse)" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                    <Button Content="CANCEL (ESC)" Command="{Binding CancelCaptureCommand}" Style="{StaticResource GhostButtonStyle}" Margin="0,20,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════ STICK-CAPTURE OVERLAY ═══════════ -->
        <Grid Background="#D90F172A" Visibility="{Binding IsCapturingStick, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="48,36" BorderBrush="#10B981">
                <StackPanel HorizontalAlignment="Center" Width="400">
                    <TextBlock Text="{Binding StickCaptureTitle}" FontSize="22" FontWeight="Black" Foreground="#10B981" HorizontalAlignment="Center"/>
                    <TextBlock Text="Push and HOLD the stick toward your target — now!" FontSize="14" Foreground="#F8FAFC" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding StickCaptureLive}" FontSize="32" FontWeight="Bold" Foreground="#06B6D4" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,16,0,2"/>
                    <TextBlock Text="{Binding StickCaptureBest}" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" MinHeight="16"/>
                    <ProgressBar Style="{StaticResource TriggerBar}" Maximum="100" Value="{Binding StickCaptureProgress, Mode=OneWay}" Foreground="#10B981" Margin="0,16,0,0"/>
                    <TextBlock Text="The strongest push wins — hold it until the bar fills." FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <Button Content="CANCEL" Command="{Binding CancelStickCaptureCommand}" Style="{StaticResource GhostButtonStyle}" Margin="0,18,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
