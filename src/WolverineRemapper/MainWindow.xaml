                                        <Button Canvas.Left="376" Canvas.Top="330" Style="{StaticResource MBadgeStyle}" DataContext="{Binding M4}"/>
                                        <Button Canvas.Left="396" Canvas.Top="364" Style="{StaticResource MBadgeStyle}" DataContext="{Binding M6}"/>

                                        <!-- Callout lines -->
                                        <Line X1="248" Y1="45" X2="152" Y2="32" Stroke="#10B981" StrokeThickness="1.5" StrokeDashArray="4 2"/>
                                        <Line X1="372" Y1="45" X2="468" Y2="32" Stroke="#10B981" StrokeThickness="1.5" StrokeDashArray="4 2"/>
                                        <Line X1="196" Y1="340" X2="152" Y2="332" Stroke="#10B981" StrokeThickness="1.5" StrokeDashArray="4 2"/>
                                        <Line X1="176" Y1="374" X2="152" Y2="402" Stroke="#10B981" StrokeThickness="1.5" StrokeDashArray="4 2"/>
                                        <Line X1="424" Y1="340" X2="468" Y2="332" Stroke="#10B981" StrokeThickness="1.5" StrokeDashArray="4 2"/>
                                        <Line X1="444" Y1="374" X2="468" Y2="402" Stroke="#10B981" StrokeThickness="1.5" StrokeDashArray="4 2"/>

                                        <!-- Callout badges (live key + chord, clickable) -->
