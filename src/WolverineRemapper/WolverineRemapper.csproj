<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.2.0</Version>
    <Authors>LupusTempestas</Authors>
    <Product>Wolverine Remapper</Product>
    <Description>Zero-lag M-button remapper for Razer Wolverine controllers (virtual Xbox 360 pad via ViGEmBus).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <EmbeddedResource Include="Localization/*.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms is only for the tray NotifyIcon; keep its implicit usings out of the WPF code. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
