<Window x:Class="WolverineRemapper.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WolverineRemapper.Views"
        xmlns:svc="clr-namespace:WolverineRemapper.Services"
        Title="Wolverine Remapper Overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">
    <!-- See-through live controller. Unlocked: drag to move, right-click to lock.
         Locked: click-through (input goes to the game); unlock from the tray or Settings. -->
    <Border x:Name="Frame" CornerRadius="12" Padding="8" Background="#0F172A" Opacity="{Binding OverlayOpacity}"
            BorderThickness="2" BorderBrush="#22D3EE" Cursor="SizeAll"
            MouseLeftButtonDown="OnDragStart" MouseRightButtonDown="OnLockRequested">
        <Border.LayoutTransform>
            <ScaleTransform ScaleX="{Binding OverlayScale}" ScaleY="{Binding OverlayScale}"/>
        </Border.LayoutTransform>
        <StackPanel>
            <views:PadView Width="260"/>
            <TextBlock x:Name="Hint" Text="{Binding [overlay_hint], Source={x:Static svc:L10n.I}}"
                       FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>
    </Border>
</Window>
